# Python bytecode and cache directories
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Tool and test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
cache/

# Terraform state and local generated files
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
terraform/output/
